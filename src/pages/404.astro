---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found - Law School Acceptance Calculator';
const description =
  'This page could not be found. Use the free calculator to check your chances at all 196 ABA-approved law schools.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="section-pad">
    <div class="page-shell">
      <div class="mx-auto max-w-xl rounded-2xl border border-[var(--line)] bg-white p-10 text-center shadow-card">
        <p class="text-sm font-semibold uppercase tracking-wide text-[var(--muted)]">404</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-[-0.02em] text-navy-950">
          Page not found
        </h1>
        <p class="mt-3 text-[var(--muted)]">
          This page doesn't exist — but your acceptance calculator does. Check your chances at all
          196 ABA-approved law schools.
        </p>
        <a
          href="/"
          class="mt-6 inline-flex items-center justify-center rounded-lg bg-navy-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
        >
          Back to the calculator
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
