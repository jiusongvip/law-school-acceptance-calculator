---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChancesCalculator from '../components/ChancesCalculator';
import ReverseCalculator from '../components/ReverseCalculator';
import CostCalculator from '../components/CostCalculator';
import ScholarshipEstimator from '../components/ScholarshipEstimator';
import LsatImpact from '../components/LsatImpact';
import ScorePositioning from '../components/ScorePositioning';
import AllSchoolsTable from '../components/AllSchoolsTable';
import { ALL_SCHOOLS, FEATURED_SCHOOLS, T14_SCHOOLS, DATA_YEAR } from '../data/schools';
import { T14_DEADLINES, TIMELINE } from '../data/costs';
import { LSAT_BANDS, GPA_BANDS, SPLITTER_PROFILES } from '../data/guides';
import { T14_PROFILES } from '../data/school-profiles';
import { COMPARISON_ROWS, COMPETITORS } from '../data/competitors';
import { FAQS } from '../data/faqs';

const title = 'Law School Acceptance Calculator - Free LSAT & GPA Chances';
const description =
  'Calculate your law school acceptance chances for free using 2025 ABA 509 data. See accept, waitlist, and reject odds at T14 and Top 50 schools. No signup.';

const faqs = FAQS;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Law School Acceptance Calculator',
  url: 'https://www.law-school-acceptance-calculator.com/',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Law School Admissions Data (${DATA_YEAR})`,
  description: `LSAT, GPA, and acceptance rate percentiles for T14 and Top 50 U.S. law schools, ${DATA_YEAR} entering class, sourced from ABA 509 Required Disclosures.`,
  license: 'https://www.americanbar.org/groups/legal_education/resources/statistics/',
  isAccessibleForFree: true,
  dateModified: `${DATA_YEAR}-12-01`,
  temporalCoverage: `${DATA_YEAR}-01-01/${DATA_YEAR}-12-31`,
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://www.law-school-acceptance-calculator.com"
  schema={[webAppSchema, faqSchema, datasetSchema]}
>
  <!-- Hero -->
  <section class="section-pad border-b border-[var(--line)] bg-[var(--surface)]">
    <div class="page-shell">
      <div class="max-w-3xl">
        <h1 class="text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-navy-950 md:text-5xl">
          Law School Acceptance Calculator
        </h1>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-[var(--muted)]">
          Enter your LSAT and GPA to see your admission chances at every T14 and Top 50 law school,
          ranked into reach, target, and safety tiers. Free, no signup, based on official ABA 509 data.
        </p>
      </div>

      <div id="calculator" class="mt-8 scroll-mt-24">
        <ChancesCalculator client:load />
      </div>

      <!-- Static fallback result, visible to crawlers without JS -->
      <noscript>
        <div class="mt-6 rounded-xl border border-[var(--line)] bg-[var(--soft)] p-6">
          <p class="font-medium text-navy-900">Example: LSAT 170 and 3.85 GPA</p>
          <p class="mt-2 text-sm text-[var(--muted)]">
            With these numbers, every T14 school is a reach, but your odds vary meaningfully:
            Georgetown and Berkeley around 12%, Cornell and Duke around 9-10%, and Yale, Stanford,
            Harvard, and Chicago near 2-4%. Enable JavaScript to calculate your own chances.
          </p>
        </div>
      </noscript>

      <!-- Tool directory -->
      <div id="tools" class="mt-10 scroll-mt-24">
        <p class="text-xs font-semibold uppercase tracking-wide text-[var(--muted)]">
          All tools
        </p>
        <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="#calculator" class="shadow-card shadow-card-hover group flex items-start gap-4 rounded-2xl border border-[var(--line)] bg-white p-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-navy-800 transition-colors group-hover:bg-navy-900 group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="5" />
                <circle cx="12" cy="12" r="1.5" fill="currentColor" />
              </svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-900">Chances Calculator</span>
              <span class="mt-1 block text-xs leading-relaxed text-[var(--muted)]">
                Accept, waitlist &amp; reject odds at every T14 and Top 50 school.
              </span>
            </span>
          </a>
          <a href="#reverse" class="shadow-card shadow-card-hover group flex items-start gap-4 rounded-2xl border border-[var(--line)] bg-white p-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-navy-800 transition-colors group-hover:bg-navy-900 group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 9h13a3 3 0 0 1 0 6H9" />
                <path d="M8 5 4 9l4 4" />
              </svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-900">Reverse Calculator</span>
              <span class="mt-1 block text-xs leading-relaxed text-[var(--muted)]">
                Find the LSAT score you need for your target school.
              </span>
            </span>
          </a>
          <a href="#score-impact" class="shadow-card shadow-card-hover group flex items-start gap-4 rounded-2xl border border-[var(--line)] bg-white p-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-navy-800 transition-colors group-hover:bg-navy-900 group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 17l6-6 4 4 8-8" />
                <path d="M14 7h7v7" />
              </svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-900">Retake Impact</span>
              <span class="mt-1 block text-xs leading-relaxed text-[var(--muted)]">
                See how a few LSAT points move your odds before you retake.
              </span>
            </span>
          </a>
          <a href="#cost" class="shadow-card shadow-card-hover group flex items-start gap-4 rounded-2xl border border-[var(--line)] bg-white p-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-navy-800 transition-colors group-hover:bg-navy-900 group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2v20" />
                <path d="M17 6.5c-1-1-2.8-1.5-5-1.5-2.5 0-4.5 1-4.5 3s2 2.5 4.5 3 4.5 1 4.5 3-2 3-4.5 3c-2.2 0-4-.5-5-1.5" />
              </svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-900">Cost Calculator</span>
              <span class="mt-1 block text-xs leading-relaxed text-[var(--muted)]">
                Estimate application fees, CAS reports &amp; LSAT retakes.
              </span>
            </span>
          </a>
          <a href="#scholarship" class="shadow-card shadow-card-hover group flex items-start gap-4 rounded-2xl border border-[var(--line)] bg-white p-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-navy-800 transition-colors group-hover:bg-navy-900 group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="9" r="5.5" />
                <path d="M9.5 14 8 22l4-2.5L16 22l-1.5-8" />
              </svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-900">Scholarship Estimator</span>
              <span class="mt-1 block text-xs leading-relaxed text-[var(--muted)]">
                Predict scholarship offers from your position at the medians.
              </span>
            </span>
          </a>
          <a href="#positioning" class="shadow-card shadow-card-hover group flex items-start gap-4 rounded-2xl border border-[var(--line)] bg-white p-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-navy-800 transition-colors group-hover:bg-navy-900 group-hover:text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 20v-8" />
                <path d="M9 20V6" />
                <path d="M14 20v-5" />
                <path d="M19 20V4" />
              </svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-900">Score Positioning</span>
              <span class="mt-1 block text-xs leading-relaxed text-[var(--muted)]">
                See where your numbers sit against each school's percentiles.
              </span>
            </span>
          </a>
        </div>
      </div>

      <div id="positioning" class="mt-8 scroll-mt-24">
        <ScorePositioning client:load />
      </div>
    </div>
  </section>

  <!-- T14 data table (static, crawlable) -->
  <section id="t14-data" class="section-pad scroll-mt-24">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        T14 Law Schools: LSAT, GPA &amp; Acceptance Rates
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Complete {DATA_YEAR} admissions data for the T14. Median LSAT and GPA are the 50th
        percentile of enrolled full-time students, from ABA 509 Required Disclosures.
      </p>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-[var(--line)] bg-white shadow-card">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-[var(--line)] bg-[var(--soft)] text-left">
              <th class="px-4 py-3 font-semibold text-navy-900">Rank</th>
              <th class="px-4 py-3 font-semibold text-navy-900">School</th>
              <th class="px-4 py-3 font-semibold text-navy-900">Acceptance Rate</th>
              <th class="px-4 py-3 font-semibold text-navy-900">LSAT Median</th>
              <th class="px-4 py-3 font-semibold text-navy-900">LSAT 25th-75th</th>
              <th class="px-4 py-3 font-semibold text-navy-900">GPA Median</th>
            </tr>
          </thead>
          <tbody>
            {T14_SCHOOLS.map((s) => (
              <tr class="border-b border-[var(--line)] last:border-0">
                <td class="px-4 py-3 text-[var(--muted)]">#{s.rank}</td>
                <td class="px-4 py-3 font-medium text-navy-900">{s.name}</td>
                <td class="px-4 py-3 tabular-nums text-navy-900">
                  {Math.round(s.acceptanceRate * 100)}%
                </td>
                <td class="px-4 py-3 font-semibold tabular-nums text-navy-900">{s.lsat.p50}</td>
                <td class="px-4 py-3 tabular-nums text-[var(--muted)]">
                  {s.lsat.p25}-{s.lsat.p75}
                </td>
                <td class="px-4 py-3 tabular-nums text-navy-900">{s.gpa.p50.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-[var(--muted)]">
        Data source:{' '}<a href="https://www.americanbar.org/groups/legal_education/resources/statistics/" target="_blank" rel="noopener" class="underline decoration-navy-200 underline-offset-2 hover:decoration-navy-800">ABA 509 Required Disclosures</a>, {DATA_YEAR} entering class.
      </p>
    </div>
  </section>

  <!-- Top 50 full table -->
  <section id="top-50" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        Top 50 Law Schools Comparison
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Compare acceptance rates, median LSAT, and median GPA across 30 of the most competitive law
        schools in the United States.
      </p>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-[var(--line)] bg-white shadow-card">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-[var(--line)] bg-[var(--soft)] text-left">
              <th class="px-4 py-3 font-semibold text-navy-900">Rank</th>
              <th class="px-4 py-3 font-semibold text-navy-900">School</th>
              <th class="px-4 py-3 font-semibold text-navy-900">Location</th>
              <th class="px-4 py-3 font-semibold text-navy-900">Acceptance Rate</th>
              <th class="px-4 py-3 font-semibold text-navy-900">LSAT Median</th>
              <th class="px-4 py-3 font-semibold text-navy-900">GPA Median</th>
            </tr>
          </thead>
          <tbody>
            {FEATURED_SCHOOLS.map((s) => (
              <tr class="border-b border-[var(--line)] last:border-0">
                <td class="px-4 py-3 text-[var(--muted)]">#{s.rank}</td>
                <td class="px-4 py-3 font-medium text-navy-900">{s.name}</td>
                <td class="px-4 py-3 text-[var(--muted)]">{s.location}</td>
                <td class="px-4 py-3 tabular-nums text-navy-900">
                  {Math.round(s.acceptanceRate * 100)}%
                </td>
                <td class="px-4 py-3 font-semibold tabular-nums text-navy-900">{s.lsat.p50}</td>
                <td class="px-4 py-3 tabular-nums text-navy-900">{s.gpa.p50.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- All 196 ABA-approved schools (interactive) -->
  <section id="all-schools" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        All 196 ABA-Approved Law Schools
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Search, filter, and sort the complete {DATA_YEAR} ABA 509 dataset — every ABA-approved
        law school in the United States, not just the ranked ones. Median LSAT and GPA are the
        50th percentile of enrolled full-time students.
      </p>
      <div class="mt-8">
        <AllSchoolsTable client:visible />
      </div>
    </div>
  </section>

  <!-- Reverse calculator -->
  <section id="reverse" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        Reverse Calculator: What LSAT Do I Need?
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Pick a target school and your current GPA to find the LSAT score you need for a given
        admission probability.
      </p>
      <div class="mt-8">
        <ReverseCalculator client:visible />
      </div>
    </div>
  </section>

  <!-- LSAT score impact -->
  <section id="score-impact" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        Should I Retake the LSAT?
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        See how much a few LSAT points actually move your chances at a target school. This helps
        you decide whether a retake is worth the time and money.
      </p>
      <div class="mt-8">
        <LsatImpact client:visible />
      </div>
    </div>
  </section>

  <!-- Application cost -->
  <section id="cost" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        Law School Application Cost Calculator
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Application fees, CAS reports, and LSAT retakes add up fast. Estimate your total outlay
        before you commit to a school list.
      </p>
      <div class="mt-8">
        <CostCalculator client:visible />
      </div>
    </div>
  </section>

  <!-- Scholarship estimator -->
  <section id="scholarship" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        Law School Scholarship Estimator
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Scholarships track the same medians as admission: the more you sit above a school's LSAT
        and GPA medians, the larger the offer. See your scholarship outlook at every T14 and Top 50
        school.
      </p>
      <div class="mt-8">
        <ScholarshipEstimator client:visible />
      </div>
    </div>
  </section>

  <!-- Deadlines & timeline -->
  <section id="deadlines" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell">
      <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
        T14 Application Deadlines
      </h2>
      <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
        Regular and early decision deadlines for the T14. Dates reflect the 2025-2026 cycle and
        shift slightly each year, so always confirm on each school's website.
      </p>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-[var(--line)] bg-white shadow-card">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-[var(--line)] bg-[var(--soft)] text-left">
              <th class="px-4 py-3 font-semibold text-navy-900">School</th>
              <th class="px-4 py-3 font-semibold text-navy-900">Early Decision</th>
              <th class="px-4 py-3 font-semibold text-navy-900">Regular Decision</th>
              <th class="px-4 py-3 font-semibold text-navy-900">App Fee</th>
            </tr>
          </thead>
          <tbody>
            {T14_DEADLINES.map((d) => (
              <tr class="border-b border-[var(--line)] last:border-0">
                <td class="px-4 py-3 font-medium text-navy-900">{d.name}</td>
                <td class="px-4 py-3 text-[var(--muted)]">
                  {d.earlyDecision ?? <span class="text-xs">Not offered</span>}
                </td>
                <td class="px-4 py-3 font-semibold tabular-nums text-navy-900">
                  {d.regularDecision}
                </td>
                <td class="px-4 py-3 tabular-nums text-[var(--muted)]">${d.applicationFee}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold tracking-tight text-navy-900">
            Application timeline
          </h3>
          <ol class="mt-4 space-y-4">
            {TIMELINE.map((t, i) => (
              <li class="flex gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-navy-900 text-xs font-semibold text-white">
                  {i + 1}
                </span>
                <div>
                  <p class="text-sm font-semibold text-navy-900">{t.when}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[var(--muted)]">{t.task}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-xl border border-[var(--line)] bg-[var(--soft)] p-6">
          <h3 class="text-xl font-semibold tracking-tight text-navy-900">
            Why early application matters
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
            Nearly all T14 schools use rolling admissions, meaning they review applications as they
            arrive and fill seats progressively. Submitting by November can put you in front of
            admissions officers before the bulk of the applicant pool arrives, which many observers
            describe as a genuine edge, especially for borderline candidates.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
            Early decision, where offered, is usually binding and can provide a modest boost, but
            only apply ED to a school you would attend regardless of cost.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Guide -->
  <section id="guide" class="section-pad scroll-mt-24 border-t border-[var(--line)]">
    <div class="page-shell grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
          How This Calculator Works
        </h2>
        <div class="mt-6 space-y-5 text-[var(--muted)] leading-relaxed">
          <p>
            This tool estimates your chances at each law school by measuring how far your LSAT and
            GPA sit from that school's enrolled-student median, then mapping that distance to a
            probability using a calibrated curve. The LSAT is weighted at 60% and GPA at 40%,
            reflecting the fact that admissions officers treat the LSAT as the stronger predictor
            of law school performance. This is the same transparent, median-based approach that
            admissions experts have used for years — no black box, no hidden model.
          </p>
          <p>
            Concretely: if your LSAT sits right at a school's median, the model anchors your odds
            near that school's reported acceptance rate. Every point above the median raises your
            probability; every point below lowers it. Because the LSAT is weighted more heavily,
            one LSAT point moves your odds more than a comparable bump in GPA — which is exactly
            how admissions offices describe their own weighting.
          </p>
          <p>
            Results are grouped into three tiers. A <strong class="text-navy-900">reach</strong> is
            a school where your estimated chance is under 25% and your numbers sit below the
            median. A <strong class="text-navy-900">target</strong> (25-55%) is a school where your
            numbers are near the median, making it a realistic option. A{' '}
            <strong class="text-navy-900">safety</strong> (above 55%) is a school where your numbers
            are above the median, giving you strong odds. Most applicants should carry schools in
            all three tiers.
          </p>
          <p>
            The underlying data comes from ABA 509 Required Disclosures, which every accredited
            law school must file annually. We use the 25th, 50th, and 75th percentile LSAT and GPA
            of enrolled full-time students for the 2025 entering class, plus each school's reported
            acceptance rate. These are the exact numbers that feed the U.S. News rankings, which
            is why they are the most reliable public admissions data available.
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-balance text-3xl font-semibold tracking-[-0.02em] text-navy-950">
          What This Calculator Cannot See
        </h2>
